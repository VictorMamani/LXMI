{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LXMI",
  "version": "0.8.7",
  "identifier": "com.bytecx.lxmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LXMI",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
