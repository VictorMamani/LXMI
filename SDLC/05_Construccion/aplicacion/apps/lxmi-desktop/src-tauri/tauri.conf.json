{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LXMI",
  "version": "0.5.3",
  "identifier": "com.bytecx.lxmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LXMI",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
